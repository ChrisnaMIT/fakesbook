{% if pageCount > 1 %}
<nav class="flex justify-center py-6" aria-label="Pagination">
    <div class="inline-flex items-center gap-1 rounded-2xl border border-slate-200 bg-white p-1.5 shadow-sm">
        {% if previous is defined %}
            <a href="{{ path(route, query|merge({(pageParameterName): previous})) }}" class="rounded-xl px-3 py-2 text-sm font-semibold text-slate-500 hover:bg-slate-100">←</a>
        {% endif %}
        {% for page in pagesInRange %}
            {% if page != current %}
                <a href="{{ path(route, query|merge({(pageParameterName): page})) }}" class="flex h-9 min-w-9 items-center justify-center rounded-xl px-2 text-sm font-semibold text-slate-600 hover:bg-slate-100">{{ page }}</a>
            {% else %}
                <span class="flex h-9 min-w-9 items-center justify-center rounded-xl bg-blue-600 px-2 text-sm font-bold text-white shadow-md shadow-blue-200">{{ page }}</span>
            {% endif %}
        {% endfor %}
        {% if next is defined %}
            <a href="{{ path(route, query|merge({(pageParameterName): next})) }}" class="rounded-xl px-3 py-2 text-sm font-semibold text-slate-500 hover:bg-slate-100">→</a>
        {% endif %}
    </div>
</nav>
{% endif %}
