{% extends 'base.html.twig' %}
{% block title %}Amis · Fakebook{% endblock %}
{% block body %}
<div class="mx-auto max-w-6xl px-4 py-8">
    <div class="mb-8"><p class="text-sm font-bold uppercase tracking-wider text-blue-600">Communauté</p><h1 class="mt-1 text-3xl font-black">Amis et découvertes</h1><p class="mt-2 text-slate-500">Retrouve tes amis et découvre de nouvelles personnes.</p></div>

    {% if app.user.profile.receivedFriendRequests|length %}
    <section class="mb-8"><h2 class="mb-4 text-xl font-black">Demandes reçues <span class="ml-2 rounded-full bg-blue-100 px-2.5 py-1 text-xs text-blue-700">{{ app.user.profile.receivedFriendRequests|length }}</span></h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{% for receivedRequest in app.user.profile.receivedFriendRequests %}<article class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex items-center gap-3"><span class="flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 text-xl font-bold text-white">{{ receivedRequest.sender.ofUser.email|first|upper }}</span><div class="min-w-0"><p class="truncate font-bold">{{ receivedRequest.sender.displayName ?: receivedRequest.sender.ofUser.email }}</p><p class="text-sm text-slate-400">Souhaite devenir votre ami</p></div></div><div class="mt-5 grid grid-cols-2 gap-2"><a href="{{ path('app_accept_friend_request', {id: receivedRequest.id}) }}" class="rounded-xl bg-blue-600 px-3 py-2.5 text-center text-sm font-bold text-white">Accepter</a><a href="{{ path('app_decline_friend_request', {id: receivedRequest.id}) }}" class="rounded-xl bg-slate-100 px-3 py-2.5 text-center text-sm font-bold text-slate-600">Refuser</a></div></article>{% endfor %}</div>
    </section>{% endif %}

    <section class="mb-8"><div class="mb-4 flex items-center justify-between"><h2 class="text-xl font-black">Découvrir des personnes</h2></div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{% for profile in profiles %}{% if profile != app.user.profile %}<article class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"><div class="flex items-center gap-3">{% if profile.image and profile.image.imageName %}<img src="{{ vich_uploader_asset(profile.image, 'imageFile') | imagine_filter('imageProfile') }}" class="h-14 w-14 rounded-full object-cover" alt="">{% else %}<span class="flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 text-xl font-bold text-white">{{ profile.ofUser.email|first|upper }}</span>{% endif %}<div class="min-w-0"><p class="truncate font-bold">{{ profile.displayName ?: profile.ofUser.email }}</p><p class="text-sm text-slate-400">Membre Fakebook</p></div></div><div class="mt-5 flex gap-2">{% if not app.user.profile.isFriendsWith(profile) and not app.user.profile.isPendingFriendRequest(profile) %}<a href="{{ path('app_send_friend_request', {id: profile.id}) }}" class="flex-1 rounded-xl bg-blue-600 px-3 py-2.5 text-center text-sm font-bold text-white">Ajouter</a>{% endif %}<a href="{{ path('app_chat_initiate', {id: profile.id}) }}" class="flex-1 rounded-xl bg-slate-100 px-3 py-2.5 text-center text-sm font-bold text-slate-700">Message</a></div></article>{% endif %}{% else %}<p class="col-span-full rounded-3xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">Aucune personne à afficher.</p>{% endfor %}</div>
    </section>

    <div class="grid gap-6 lg:grid-cols-2">
        <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="mb-4 text-lg font-black">Mes amis</h2><div class="space-y-2">{% for friend in app.user.profile.getFriends() %}<div class="flex items-center gap-3 rounded-2xl p-3 hover:bg-slate-50"><span class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-100 font-bold text-blue-700">{{ friend.ofUser.email|first|upper }}</span><span class="min-w-0 flex-1 truncate font-semibold">{{ friend.displayName ?: friend.ofUser.email }}</span><a href="{{ path('app_chat_initiate', {id: friend.id}) }}" class="rounded-xl bg-slate-100 px-3 py-2 text-xs font-bold">Message</a></div>{% else %}<p class="py-5 text-center text-sm text-slate-400">Pas encore d’amis.</p>{% endfor %}</div></section>
        <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="mb-4 text-lg font-black">Demandes envoyées</h2><div class="space-y-2">{% for sentRequest in app.user.profile.sentRequest %}<div class="flex items-center gap-3 rounded-2xl bg-slate-50 p-3"><span class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-200 font-bold">{{ sentRequest.recipient.ofUser.email|first|upper }}</span><span class="min-w-0 flex-1 truncate font-semibold">{{ sentRequest.recipient.displayName ?: sentRequest.recipient.ofUser.email }}</span><span class="text-xs font-semibold text-amber-600">En attente</span></div>{% else %}<p class="py-5 text-center text-sm text-slate-400">Aucune demande en attente.</p>{% endfor %}</div></section>
    </div>
</div>
{% endblock %}
