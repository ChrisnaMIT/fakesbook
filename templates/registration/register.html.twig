{% extends 'base.html.twig' %}
{% block title %}Créer un compte · Fakebook{% endblock %}
{% block body %}
<div class="flex min-h-screen items-center justify-center bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 px-5 py-12">
    <div class="w-full max-w-lg rounded-[2rem] border border-white/80 bg-white/90 p-7 shadow-2xl shadow-blue-200/40 backdrop-blur sm:p-10">
        <a href="{{ path('app_login') }}" class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-blue-600">← Retour à la connexion</a>
        <div class="flex items-center gap-3"><span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-600 text-3xl font-black text-white">f</span><div><h1 class="text-2xl font-black">Rejoins Fakebook</h1><p class="text-sm text-slate-500">Crée ton compte en quelques secondes.</p></div></div>
        {{ form_start(registrationForm, {attr: {class: 'mt-8 space-y-5'}}) }}
            <div>{{ form_label(registrationForm.email, 'Adresse email', {label_attr: {class: 'mb-2 block text-sm font-bold'}}) }}{{ form_widget(registrationForm.email, {attr: {class: 'w-full rounded-2xl border border-slate-200 px-4 py-3.5 focus:border-blue-500 focus:ring-4 focus:ring-blue-100', placeholder: 'nom@exemple.com'}}) }}<div class="mt-1 text-sm text-rose-600">{{ form_errors(registrationForm.email) }}</div></div>
            <div>{{ form_label(registrationForm.plainPassword, 'Mot de passe', {label_attr: {class: 'mb-2 block text-sm font-bold'}}) }}{{ form_widget(registrationForm.plainPassword, {attr: {class: 'w-full rounded-2xl border border-slate-200 px-4 py-3.5 focus:border-blue-500 focus:ring-4 focus:ring-blue-100', placeholder: '8 caractères minimum'}}) }}<div class="mt-1 text-sm text-rose-600">{{ form_errors(registrationForm.plainPassword) }}</div></div>
            <div class="rounded-2xl bg-slate-50 p-4 text-sm text-slate-600">{{ form_row(registrationForm.agreeTerms) }}</div>
            <button class="w-full rounded-2xl bg-blue-600 px-5 py-3.5 font-bold text-white shadow-xl shadow-blue-200 hover:bg-blue-700">Créer mon compte</button>
        {{ form_end(registrationForm) }}
        <p class="mt-6 text-center text-sm text-slate-500">Déjà inscrit ? <a href="{{ path('app_login') }}" class="font-bold text-blue-600">Se connecter</a></p>
    </div>
</div>
{% endblock %}
