<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#2563eb">
    <title>{% block title %}Fakebook{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2232%22 fill=%22%232563eb%22/><text y=%2292%22 x=%2235%22 font-size=%2280%22 font-family=%22Arial%22 font-weight=%22bold%22 fill=%22white%22>f</text></svg>">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
    {% block javascript %}
        {% block importmap %}{{ importmap() }}{% endblock %}
    {% endblock %}
</head>
<body class="min-h-screen bg-slate-50 text-slate-900 antialiased selection:bg-blue-100 selection:text-blue-900">
    {% include 'navbar/navbar.html.twig' %}
    <main class="{% if app.user %}pt-20{% endif %} min-h-screen">
        {% for label, messages in app.flashes %}
            <div class="fixed right-4 top-20 z-50 w-[calc(100%-2rem)] max-w-sm space-y-2">
                {% for message in messages %}
                    <div class="rounded-2xl border border-slate-200 bg-white px-5 py-4 text-sm font-medium shadow-xl shadow-slate-200/60">
                        {{ message }}
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
        {% block body %}{% endblock %}
    </main>
</body>
</html>
