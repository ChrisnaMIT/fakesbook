<header class="fixed inset-x-0 top-0 z-50 border-b border-slate-200/80 bg-white/95 shadow-sm backdrop-blur-xl">
    <nav class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-3 px-4 sm:px-6">
        <a href="{{ app.user ? path('app_post') : path('app_login') }}" class="flex shrink-0 items-center gap-2.5">
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 text-2xl font-black text-white shadow-lg shadow-blue-200">f</span>
            <span class="hidden text-xl font-black tracking-tight text-slate-900 sm:block">fakebook</span>
        </a>

        {% if app.user %}
            <div class="hidden max-w-sm flex-1 md:block">
                <a href="{{ path('app_people') }}" class="flex h-10 items-center gap-3 rounded-full bg-slate-100 px-4 text-sm text-slate-500 transition hover:bg-slate-200">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-width="2" d="m21 21-4.35-4.35m2.1-5.4a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"/></svg>
                    Rechercher des personnes
                </a>
            </div>

            <div class="flex items-center gap-1 sm:gap-2">
                <a href="{{ path('app_post') }}" title="Accueil" class="flex h-10 w-10 items-center justify-center rounded-xl text-slate-500 transition hover:bg-blue-50 hover:text-blue-600">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m3 11 9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-9Z"/></svg>
                </a>
                <a href="{{ path('app_people') }}" title="Amis" class="flex h-10 w-10 items-center justify-center rounded-xl text-slate-500 transition hover:bg-blue-50 hover:text-blue-600">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.87m-2-12a4 4 0 0 1 0 7.75"/></svg>
                </a>
                <a href="{{ path('app_notification') }}" title="Notifications" class="relative flex h-10 w-10 items-center justify-center rounded-xl text-slate-500 transition hover:bg-blue-50 hover:text-blue-600">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17H5.5A1.5 1.5 0 0 1 4 15.5c1.5-1.5 2-3.5 2-6a6 6 0 1 1 12 0c0 2.5.5 4.5 2 6a1.5 1.5 0 0 1-1.5 1.5H15Zm0 0a3 3 0 0 1-6 0"/></svg>
                    <span class="absolute right-2 top-2 h-2 w-2 rounded-full bg-rose-500 ring-2 ring-white"></span>
                </a>
                {% if app.user.profile %}
                    <a href="{{ path('app_profile', {id: app.user.profile.id}) }}" class="ml-1 flex items-center gap-2 rounded-full border border-slate-200 bg-white p-1 pr-2 transition hover:border-blue-200 hover:bg-blue-50">
                        {% if app.user.profile.image and app.user.profile.image.imageName %}
                            <img src="{{ vich_uploader_asset(app.user.profile.image, 'imageFile') | imagine_filter('imageProfile') }}" alt="" class="h-8 w-8 rounded-full object-cover">
                        {% else %}
                            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 text-sm font-bold text-white">{{ app.user.email|first|upper }}</span>
                        {% endif %}
                        <span class="hidden max-w-28 truncate text-sm font-semibold lg:block">{{ app.user.profile.displayName ?: app.user.email }}</span>
                    </a>
                {% endif %}
                <a href="{{ path('app_logout') }}" title="Déconnexion" class="flex h-10 w-10 items-center justify-center rounded-xl text-slate-400 transition hover:bg-rose-50 hover:text-rose-600">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 17l5-5-5-5m5 5H3m11-9h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5"/></svg>
                </a>
            </div>
        {% else %}
            <div class="flex items-center gap-2">
                <a href="{{ path('app_login') }}" class="rounded-xl px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100">Connexion</a>
                <a href="{{ path('app_register') }}" class="rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-blue-200 hover:bg-blue-700">Créer un compte</a>
            </div>
        {% endif %}
    </nav>
</header>
