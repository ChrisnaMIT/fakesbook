{% extends 'base.html.twig' %}
{% block title %}{{ post.title }} · Fakebook{% endblock %}
{% block body %}
<div class="mx-auto max-w-3xl px-4 py-8">
    <a href="{{ path('app_post') }}" class="mb-5 inline-flex items-center gap-2 text-sm font-bold text-slate-500 hover:text-blue-600">← Retour au fil</a>
    <article class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <div class="flex items-start gap-3 p-5">
            {% if post.author.profile and post.author.profile.image and post.author.profile.image.imageName %}<img src="{{ vich_uploader_asset(post.author.profile.image, 'imageFile') | imagine_filter('imageProfile') }}" class="h-12 w-12 rounded-full object-cover" alt="">{% else %}<span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-600 font-bold text-white">{{ post.author.email|first|upper }}</span>{% endif %}
            <div class="min-w-0 flex-1"><p class="truncate font-bold">{{ post.author.profile and post.author.profile.displayName ? post.author.profile.displayName : post.author.email }}</p><p class="text-xs text-slate-400">{{ post.createdAt|date('d/m/Y à H:i') }} · Public</p></div>
            {% if app.user == post.author %}<div class="flex gap-2"><form method="post" action="{{ path('app_post_images', {id: post.id}) }}"><button class="rounded-xl bg-slate-100 px-3 py-2 text-xs font-bold">Images</button></form><form method="post" action="{{ path('app_post_delete', {id: post.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce post ?');"><input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}"><button class="rounded-xl bg-rose-50 px-3 py-2 text-xs font-bold text-rose-600">Supprimer</button></form></div>{% endif %}
        </div>
        <div class="px-5 pb-5"><h1 class="text-2xl font-black">{{ post.title }}</h1><p class="mt-3 whitespace-pre-line leading-7 text-slate-700">{{ post.content }}</p></div>
        {% if post.images|length %}<div class="{% if post.images|length > 1 %}grid grid-cols-2 gap-0.5{% endif %} bg-slate-100">{% for image in post.images %}<img src="{{ vich_uploader_asset(image, 'imageFile') | imagine_filter('postshow') }}" alt="" class="max-h-[720px] w-full object-cover">{% endfor %}</div>{% endif %}
        <div class="px-5"><div class="flex justify-between border-b border-slate-100 py-3 text-sm text-slate-500"><span>{{ post.likes|length }} J’aime</span><span>{{ post.comments|length }} commentaire{% if post.comments|length != 1 %}s{% endif %}</span></div><div class="flex py-1">{% include 'like/like.html.twig' %}<a href="{{ path('app_share_with', {id: post.id}) }}" class="flex flex-1 items-center justify-center rounded-xl py-2.5 text-sm font-semibold text-slate-500 hover:bg-slate-50">↗ Partager</a></div></div>
    </article>
    <section class="mt-5 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="mb-5 text-lg font-black">Commentaires</h2>
        <div class="space-y-4">{% for comment in post.comments %}<div class="flex items-start gap-3">{% if comment.author.profile and comment.author.profile.image and comment.author.profile.image.imageName %}<img src="{{ vich_uploader_asset(comment.author.profile.image, 'imageFile') | imagine_filter('imageProfile') }}" class="h-10 w-10 rounded-full object-cover" alt="">{% else %}<span class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-200 text-sm font-bold">{{ comment.author.email|first|upper }}</span>{% endif %}<div><div class="rounded-2xl bg-slate-100 px-4 py-3"><p class="text-xs font-bold">{{ comment.author.profile and comment.author.profile.displayName ? comment.author.profile.displayName : comment.author.email }}</p><p class="mt-1 text-sm text-slate-700">{{ comment.content }}</p></div><p class="mt-1 px-2 text-[11px] text-slate-400">{{ comment.createdAt|date('d/m/Y à H:i') }}</p></div></div>{% else %}<p class="py-8 text-center text-sm text-slate-400">Sois le premier à commenter.</p>{% endfor %}</div>
        {% if app.user %}{{ form_start(form, {action: path('app_comment', {id: post.id}), attr: {class: 'mt-5 flex items-center gap-2 border-t border-slate-100 pt-5'}}) }}{{ form_widget(form.content, {attr: {placeholder: 'Écrire un commentaire…', class: 'flex-1 rounded-full border-0 bg-slate-100 px-4 py-3 text-sm focus:ring-2 focus:ring-blue-500'}}) }}<button type="submit" class="flex h-11 w-11 items-center justify-center rounded-full bg-blue-600 font-bold text-white">➤</button>{{ form_end(form) }}{% endif %}
    </section>
</div>
{% endblock %}
