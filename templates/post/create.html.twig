{% extends 'base.html.twig' %}
{% block title %}Créer une publication · Fakebook{% endblock %}
{% block body %}
<div class="mx-auto max-w-2xl px-4 py-8">
    <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-200/50">
        <div class="border-b border-slate-100 px-6 py-5"><div class="flex items-center justify-between"><div><p class="text-sm font-bold text-blue-600">NOUVELLE PUBLICATION</p><h1 class="mt-1 text-2xl font-black">Partage quelque chose</h1></div><a href="{{ path('app_post') }}" class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-xl text-slate-500 hover:bg-slate-200">×</a></div></div>
        <div class="p-6">
            <div class="mb-6 flex items-center gap-3">
                {% if app.user.profile and app.user.profile.image and app.user.profile.image.imageName %}<img src="{{ vich_uploader_asset(app.user.profile.image, 'imageFile') | imagine_filter('imageProfile') }}" class="h-12 w-12 rounded-full object-cover" alt="">{% else %}<span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-600 font-bold text-white">{{ app.user.email|first|upper }}</span>{% endif %}
                <div><p class="font-bold">{{ app.user.profile and app.user.profile.displayName ? app.user.profile.displayName : app.user.email }}</p><span class="rounded-lg bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-500">Public</span></div>
            </div>
            {{ form_start(form, {attr: {class: 'space-y-5'}}) }}{{ form_errors(form) }}
                <div>{{ form_widget(form.title, {attr: {class: 'w-full border-0 p-0 text-xl font-bold placeholder:text-slate-300 focus:ring-0', placeholder: 'Titre de la publication'}}) }}<div class="text-sm text-rose-600">{{ form_errors(form.title) }}</div></div>
                <div>{{ form_widget(form.content, {attr: {class: 'min-h-44 w-full resize-none rounded-2xl border-0 bg-slate-50 p-4 leading-7 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-500', placeholder: 'Quoi de neuf ?'}}) }}<div class="text-sm text-rose-600">{{ form_errors(form.content) }}</div></div>
                <div class="flex items-center justify-between rounded-2xl border border-slate-200 p-4"><span class="text-sm font-bold">Ajouter à votre publication</span><span class="text-2xl text-emerald-500">▣</span></div>
                <button type="submit" class="w-full rounded-2xl bg-blue-600 px-5 py-3.5 font-bold text-white shadow-xl shadow-blue-200 hover:bg-blue-700">Publier</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
