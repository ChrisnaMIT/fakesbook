{% extends 'base.html.twig' %}
{% block title %}Connexion · Fakebook{% endblock %}
{% block body %}
<div class="grid min-h-screen lg:grid-cols-2">
    <section class="hidden bg-gradient-to-br from-blue-600 via-indigo-600 to-violet-700 p-16 text-white lg:flex lg:flex-col lg:justify-between">
        <div class="flex items-center gap-3"><span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-3xl font-black text-blue-600">f</span><span class="text-2xl font-black">fakebook</span></div>
        <div class="max-w-xl"><p class="mb-6 text-sm font-bold uppercase tracking-[.25em] text-blue-200">Connecter. Partager. Échanger.</p><h1 class="text-5xl font-black leading-tight">Reste proche des personnes qui comptent vraiment.</h1><p class="mt-6 text-lg leading-8 text-blue-100">Retrouve tes amis, partage tes moments et discute en temps réel dans un espace qui te ressemble.</p></div>
        <p class="text-sm text-blue-200">Fakebook © {{ 'now'|date('Y') }}</p>
    </section>
    <section class="flex items-center justify-center bg-slate-50 px-5 py-12">
        <div class="w-full max-w-md">
            <div class="mb-8 lg:hidden"><span class="text-3xl font-black text-blue-600">fakebook</span></div>
            <p class="font-semibold text-blue-600">Bon retour parmi nous</p>
            <h2 class="mt-2 text-4xl font-black tracking-tight">Connecte-toi</h2>
            <p class="mt-3 text-slate-500">Accède à ton fil et retrouve tes amis.</p>
            {% if error %}<div class="mt-6 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm font-medium text-rose-700">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
            {% if app.user %}<div class="mt-6 rounded-2xl bg-blue-50 p-4 text-sm">Connecté en tant que {{ app.user.userIdentifier }}. <a href="{{ path('app_logout') }}" class="font-bold text-blue-600">Se déconnecter</a></div>{% endif %}
            <form method="post" class="mt-8 space-y-5">
                <div><label for="inputEmail" class="mb-2 block text-sm font-bold">Adresse email</label><input type="email" value="{{ last_username }}" name="email" id="inputEmail" required autofocus autocomplete="email" placeholder="nom@exemple.com" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100"></div>
                <div><label for="inputPassword" class="mb-2 block text-sm font-bold">Mot de passe</label><input type="password" name="password" id="inputPassword" required autocomplete="current-password" placeholder="••••••••" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100"></div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <label class="flex items-center gap-3 text-sm text-slate-600"><input type="checkbox" name="_remember_me" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">Se souvenir de moi</label>
                <button class="w-full rounded-2xl bg-blue-600 px-5 py-3.5 font-bold text-white shadow-xl shadow-blue-200 transition hover:-translate-y-0.5 hover:bg-blue-700">Se connecter</button>
                <a href="{{ path('connect_google_start') }}" class="flex w-full items-center justify-center gap-3 rounded-2xl border border-slate-200 bg-white px-5 py-3.5 font-bold text-slate-700 hover:bg-slate-50"><span class="text-lg font-black text-blue-600">G</span>Continuer avec Google</a>
            </form>
            <p class="mt-8 text-center text-sm text-slate-500">Pas encore de compte ? <a href="{{ path('app_register') }}" class="font-bold text-blue-600 hover:underline">Inscris-toi gratuitement</a></p>
        </div>
    </section>
</div>
{% endblock %}
