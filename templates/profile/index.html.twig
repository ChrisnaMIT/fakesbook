{% extends 'base.html.twig' %}
{% block title %}Profil · Fakebook{% endblock %}
{% block body %}
<div class="pb-12">
    <div class="h-52 bg-gradient-to-br from-blue-500 via-indigo-500 to-violet-600 sm:h-72"></div>
    <div class="mx-auto max-w-5xl px-4">
        <div class="relative rounded-b-3xl border-x border-b border-slate-200 bg-white px-5 pb-5 shadow-sm sm:px-8">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
                <div class="-mt-16 shrink-0 rounded-full bg-white p-1.5 shadow-lg">
                    {% if app.user.profile.image and app.user.profile.image.imageName %}
                        <img class="h-32 w-32 rounded-full object-cover sm:h-40 sm:w-40" src="{{ vich_uploader_asset(app.user.profile.image, 'imageFile') | imagine_filter('imageProfile') }}" alt="Photo de profil">
                    {% else %}
                        <span class="flex h-32 w-32 items-center justify-center rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 text-5xl font-black text-white sm:h-40 sm:w-40">{{ app.user.email|first|upper }}</span>
                    {% endif %}
                </div>
                <div class="min-w-0 flex-1 pb-2">
                    <h1 class="truncate text-3xl font-black tracking-tight">{{ app.user.profile.displayName ?: app.user.email }}</h1>
                    <p class="mt-1 text-sm font-medium text-slate-500">{{ app.user.profile.getFriends()|length }} ami{% if app.user.profile.getFriends()|length != 1 %}s{% endif %}</p>
                </div>
                <div class="flex gap-2 pb-2">
                    {% include 'follow/follow.html.twig' %}
                    <a href="{{ path('app_addImageProfile', {id: app.user.profile.id}) }}" class="rounded-xl bg-slate-100 px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-200">Modifier la photo</a>
                </div>
            </div>
            <div class="mt-5 flex gap-2 border-t border-slate-100 pt-3">
                <span class="rounded-xl bg-blue-50 px-5 py-2.5 text-sm font-bold text-blue-600">Publications</span>
                <a href="{{ path('app_people') }}" class="rounded-xl px-5 py-2.5 text-sm font-bold text-slate-500 hover:bg-slate-50">Amis</a>
            </div>
        </div>

        <div class="mt-6 grid gap-6 lg:grid-cols-[320px_1fr]">
            <aside class="space-y-5">
                <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="text-lg font-black">Présentation</h2><p class="mt-3 text-sm leading-6 text-slate-500">Membre de Fakebook. Partage ses moments et échange avec ses amis.</p><div class="mt-4 flex items-center gap-2 text-sm text-slate-500"><span>✉</span>{{ app.user.email }}</div></div>
                <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex items-center justify-between"><h2 class="text-lg font-black">Amis</h2><a href="{{ path('app_people') }}" class="text-sm font-bold text-blue-600">Voir tout</a></div><p class="mt-1 text-sm text-slate-400">{{ app.user.profile.getFriends()|length }} personnes</p></div>
            </aside>
            <section>
                <div class="mb-4 flex items-center justify-between"><h2 class="text-xl font-black">Photos et publications</h2><a href="{{ path('app_post_create') }}" class="rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-bold text-white">Créer un post</a></div>
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                    {% for post in posts %}
                        {% for image in post.images %}
                            <a href="{{ path('app_post_show', {id: post.id}) }}" class="group aspect-square overflow-hidden rounded-2xl bg-slate-100">
                                <img src="{{ vich_uploader_asset(image, 'imageFile') | imagine_filter('imagePost') }}" alt="Image du post" class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
                            </a>
                        {% endfor %}
                    {% else %}
                        <div class="col-span-full rounded-3xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">Aucune publication pour le moment.</div>
                    {% endfor %}
                </div>
            </section>
        </div>
    </div>
</div>
{% endblock %}
