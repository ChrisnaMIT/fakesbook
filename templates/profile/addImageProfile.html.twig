{% extends 'base.html.twig' %}
{% block title %}Photo de profil · Fakebook{% endblock %}
{% block body %}
<div class="mx-auto max-w-lg px-4 py-8"><div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-xl shadow-slate-200/50"><div class="text-center"><h1 class="text-2xl font-black">Photo de profil</h1><p class="mt-2 text-sm text-slate-500">Choisis une photo qui permettra à tes amis de te reconnaître.</p>{% if app.user.profile.image and app.user.profile.image.imageName %}<img class="mx-auto mt-6 h-32 w-32 rounded-full object-cover ring-4 ring-blue-100" src="{{ vich_uploader_asset(app.user.profile.image, 'imageFile') | imagine_filter('imageProfile') }}" alt="">{% else %}<span class="mx-auto mt-6 flex h-32 w-32 items-center justify-center rounded-full bg-blue-600 text-4xl font-black text-white">{{ app.user.email|first|upper }}</span>{% endif %}<p class="mt-4 font-bold">{{ app.user.profile.displayName ?: app.user.email }}</p></div>{{ form_start(form, {attr: {class: 'mt-7 space-y-5'}}) }}<div class="rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 p-5">{{ form_row(form.imageFile, {label: false, attr: {class: 'w-full text-sm'}}) }}</div><button type="submit" class="w-full rounded-2xl bg-blue-600 px-5 py-3.5 font-bold text-white">Enregistrer la photo</button>{{ form_end(form) }}<a href="{{ path('app_post') }}" class="mt-4 block text-center text-sm font-bold text-slate-500">Annuler</a></div></div>
{% endblock %}
